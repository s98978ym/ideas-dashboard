# =============================================================================
# Slack AI Analysis Dashboard - Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in the values

# --- Database (Vercel Postgres / Neon / Supabase) ---
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# --- Slack App ---
SLACK_CLIENT_ID="your-slack-client-id"
SLACK_CLIENT_SECRET="your-slack-client-secret"
SLACK_SIGNING_SECRET="your-slack-signing-secret"

# --- Token Encryption ---
# Generate with: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY="your-64-char-hex-key"

# --- Queue (Upstash QStash) ---
QSTASH_TOKEN="your-qstash-token"
QSTASH_CURRENT_SIGNING_KEY="your-qstash-current-signing-key"
QSTASH_NEXT_SIGNING_KEY="your-qstash-next-signing-key"

# --- App URL (for OAuth redirect and queue callbacks) ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Single-User Auth (Basic Auth) ---
# Set both to enable Basic Auth protection
BASIC_AUTH_USER=""
BASIC_AUTH_PASS=""

# --- Optional: LLM API Keys (for future auto-execution) ---
# OPENAI_API_KEY=""
# ANTHROPIC_API_KEY=""
# GOOGLE_AI_API_KEY=""
